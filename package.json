{
  "name": "omo-claude-auth",
  "version": "0.1.0",
  "private": true,
  "description": "omo/senpi extension that wraps opencode-claude-auth to reuse Claude Code credentials",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "opencode-claude-auth": "^2.2.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/node": "^26.6.5",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^7"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
